# Скопируйте этот файл в .env и вставьте свой ключ.
# Ключ берётся здесь: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Свой OpenAI-совместимый провайдер (OpenRouter, Groq, Ollama, LM Studio, vLLM):
# ключ кладётся сюда, а адрес и алиас модели — в config.json (model.base_url и
# model.name) или в окно «Ключ и провайдер». Имя переменной можно сменить:
# model.api_key_env.
# OPENAI_API_KEY=
